# Discord application credentials
# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# FACEIT Data API key
# Create an app at https://developers.faceit.com/
FACEIT_API_KEY=

# PostgreSQL connection string
# For local development (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insomniacs

# Bot behaviour
BOT_TIMEZONE=Europe/London
CHEMISTRY_MIN_MATCHES=10

# Runtime
NODE_ENV=development
LOG_LEVEL=info
