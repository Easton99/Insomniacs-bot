# Discord application credentials
# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set to a specific server ID for instant command registration during dev.
# Leave blank to register commands globally (works in all servers, ~1 hour to propagate).
DISCORD_GUILD_ID=

# FACEIT Data API key
# Create an app at https://developers.faceit.com/
FACEIT_API_KEY=

# SQLite database file path (relative to project root)
DATABASE_URL=file:./data.db

# Bot behaviour
BOT_TIMEZONE=Europe/London
CHEMISTRY_MIN_MATCHES=10

# Runtime
NODE_ENV=development
LOG_LEVEL=info
