generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Phase 1: minimal schema — extended in Phase 2+ ───────────────────────────

model DiscordUser {
  discordId String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discord_users")
}
