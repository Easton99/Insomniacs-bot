generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Stores Discord → FACEIT account links.
// All match data is fetched live from FACEIT API — nothing is cached here.
model DiscordUser {
  discordId      String   @id
  faceitId       String   @unique
  faceitNickname String
  linkedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// User-generated quotes saved via right-click → Save Quote.
// The only content that cannot be derived from an external API.
model Quote {
  id               String   @id @default(cuid())
  text             String
  authorDiscordId  String
  savedByDiscordId String
  channelId        String
  messageId        String   @unique
  quotedAt         DateTime
  createdAt        DateTime @default(now())
}
