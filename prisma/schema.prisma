generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Stores Discord → FACEIT account links.
// All match data is fetched live from FACEIT API — nothing is cached here.
model DiscordUser {
  discordId      String   @id
  faceitId       String   @unique
  faceitNickname String
  linkedAt       DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// User-generated quotes saved via right-click → Save Quote.
// The only content that cannot be derived from an external API.
model Quote {
  id               String   @id @default(cuid())
  text             String
  authorDiscordId  String
  savedByDiscordId String
  channelId        String
  messageId        String   @unique
  quotedAt         DateTime
  createdAt        DateTime @default(now())
}

// Birthdays are stored per server: a user's birthday is only announced in
// servers where they set it themselves.
model Birthday {
  guildId           String
  discordId         String
  day               Int
  month             Int
  // Year the birthday was last announced — prevents duplicate posts
  lastAnnouncedYear Int?
  // Year of the birthday the one-week reminder was last posted for
  lastRemindedYear  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([guildId, discordId])
  @@index([guildId, month, day])
}

// Per-server settings. birthdayChannelId must be set by an admin before
// any birthday announcements are posted in that server.
model GuildSettings {
  guildId           String   @id
  birthdayChannelId String?
  updatedAt         DateTime @updatedAt
}
